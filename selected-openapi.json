{
  "openapi": "3.1.0",
  "info": {
    "title": "AssemblyAI selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.assemblyai.com"
    }
  ],
  "paths": {
    "/v2/transcript": {
      "get": {
        "operationId": "assemblyai_list_transcripts",
        "summary": "assemblyai list transcripts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "assemblyai_submit_transcript",
        "summary": "Submit an asynchronous transcription; poll get_transcript for completion. May consume provider credits.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "language_detection": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "audio_url"
                ]
              }
            }
          }
        }
      }
    },
    "/v2/transcript/{transcript_id}": {
      "get": {
        "operationId": "assemblyai_get_transcript",
        "summary": "assemblyai get transcript",
        "parameters": [
          {
            "name": "transcript_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
